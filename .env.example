# Copy to .env for Docker Compose or .env.local for Python development. Never commit either file.
# Defaults run the offline synthetic demo safely on localhost; no credential is required.
# Trusted operator settings cannot be selected by HTTP request data.

# Runtime profile. Production intentionally refuses startup until production identity exists.
STA_ENVIRONMENT=development
# Service/log identity and formatting. DEBUG may expose more operational detail locally.
STA_SERVICE_NAME=security-triage-agent
STA_LOG_LEVEL=INFO
STA_LOG_FORMAT=json
# Python-local SQLite path. Compose overrides this with its named-volume path.
STA_DATABASE_URL=sqlite:///security-triage-agent.db
# Versioned synthetic-only evidence and evaluation locations.
STA_FIXTURE_PATH=fixtures/v1
STA_EVALUATION_PATH=evaluations/v1/manifest.json
# Request and approval/recovery bounds; values are seconds except request bytes.
STA_MAX_REQUEST_BYTES=65536
STA_APPROVAL_LIFETIME_SECONDS=900
STA_STALE_EXECUTION_SECONDS=900
STA_STALE_ACTION_EXECUTION_SECONDS=300
# `demo` is offline and recommended. `openai` is optional, external, and advisory.
STA_REASONER_PROVIDER=demo
# Trusted provider configuration. Request bodies cannot select these values.
STA_OPENAI_MODEL=gpt-5.6-luna
STA_OPENAI_REQUEST_TIMEOUT_SECONDS=25
STA_OPENAI_MAX_OUTPUT_TOKENS=1500
# Reviewed values: openai-l1-v1 (default, frozen baseline) or openai-l1-v2 (experimental).
STA_OPENAI_PROMPT_VERSION=openai-l1-v1

# SQLite and demo mode require no credentials. Uncomment only for explicit OpenAI mode.
# Never use a production credential for this synthetic demo or commit the local .env file.
# OPENAI_API_KEY=replace-with-your-local-development-key
