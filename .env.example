# Copy to .env for local development. Never commit .env.
STA_ENVIRONMENT=development
STA_SERVICE_NAME=security-triage-agent
STA_LOG_LEVEL=INFO
STA_LOG_FORMAT=json
STA_DATABASE_URL=sqlite:///security-triage-agent.db

# SQLite requires no credentials for local development or the offline test suite.
# OpenAI and external security-provider configuration will be added only in their approved milestones.
